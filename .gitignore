# Temporary files
.scratch/

# Environment and credentials
.env
*.pem
*.key
config/integrations.yaml

# Claude Code local settings (permissions are per-user)
.claude/settings.local.json

# Memory data (optional - remove if you want to track)
memory/data/

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
*.egg-info/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# SQLite WAL files
*.sqlite-shm
*.sqlite-wal
*.db-shm
*.db-wal

# Managed dependencies (cloned repos)
.aOS/deps/*/repo/

# Logs (daily notes are intentionally tracked)
# memory/daily-notes/ - tracked
.aOS/logs/sessions/*.jsonl
.aOS/logs/pipeline/events.jsonl
.aOS/logs/pipeline/hook-runs.jsonl
.aOS/logs/pipeline/inbox/
.aOS/logs/pipeline/claimed/
