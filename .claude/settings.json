{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-check",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-mirror && \"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-digest",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-mirror && \"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-digest",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-mirror && \"$CLAUDE_PROJECT_DIR\"/.aOS/app/memory/memory session-digest",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ]
  }
}
